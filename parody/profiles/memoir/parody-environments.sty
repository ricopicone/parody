% Pandoc emits \tightlist in itemize/enumerate output; define it (standard
% pandoc-template definition) so generic-profile builds compile.
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Pandoc >= 3.2 wraps images in \pandocbounded (scale down to fit the text
% area); definition from pandoc's default template, needed because the
% profile supplies its own main.tex.
\makeatletter
\@ifundefined{pandocbounded}{%
  \newsavebox\pandoc@box
  \newcommand*\pandocbounded[1]{%
    \sbox\pandoc@box{#1}%
    \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
    \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
    \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
    \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
    \else\usebox{\pandoc@box}%
    \fi%
  }
}{}
\makeatother

% ---- \maxwidth: natural image width, capped at \linewidth (pandoc idiom);
