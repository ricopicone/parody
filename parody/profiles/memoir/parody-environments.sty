% parody print environments — the profile contract (see ../PROFILE-CONTRACT.md).
% Implements the environments and commands emitted by parody/filters/print.lua.
% Ported from the generic `print` profile's parody-print.sty, with literal
% colours abstracted to the theme's named colours (parody{thm,info,ex,out}*) so
% the look is themeable, and with body/math fonts left to the class + theme.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{parody-environments}[2026/06/26 parody print environments (profile contract)]

\RequirePackage{mathtools}
\RequirePackage{cancel}
\RequirePackage{pgf} % matplotlib-exported figures via \inputpgf
% matplotlib's pgf backend wraps math in \mathdefault; identity is the
% upstream-recommended definition outside matplotlib's own preamble.
\providecommand{\mathdefault}[1]{#1}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{longtable} % pandoc emits it for pipe tables
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{minted}
\RequirePackage{xsim}
\RequirePackage{menukeys}
\RequirePackage{xurl}
\RequirePackage{fontawesome5}
\RequirePackage{imakeidx}
\RequirePackage{etoolbox}
% Lists set tight. Markdown separates list items with a blank line far more
% often than the author means "loose list", and pandoc faithfully renders that
% as \itemsep/\parsep — a blank line between every item. The house style takes
% the decision away: items sit one line apart whether the source spaced them
% or not, numbered and bulleted alike.
\RequirePackage{enumitem}
\setlist{itemsep=0pt, parsep=0pt, topsep=\smallskipamount, partopsep=0pt}
\RequirePackage{hyperref}
% Links carry no visible border. hyperref's default draws a box around every
% cross-reference, and this PDF is something students PRINT — a section at a
% time, or the whole book — so 259 boxes would be 259 boxes on paper. Set via
% \hypersetup rather than the `hidelinks` package option: a book preamble that
% loads hyperref itself would make the option an unrecoverable clash, and
% pdfborder is the form every hyperref version accepts.
\hypersetup{pdfborder={0 0 0}}
% No `capitalise`: cross-ref labels follow the case of the reference key, so
% [@fig:foo] -> \cref -> "figure 1" and [@Fig:foo] -> \Cref -> "Figure 1"
% (task #296). `capitalise` would force \cref to capitalize too, defeating
% the lowercase intent that print.lua's crossref/hashref handlers encode.
\RequirePackage[noabbrev,nameinlink]{cleveref}

\makeindex

% ---- conditional build flags (set by the writer via \def before \input) ----
% \issolution  : solutions manual build (print solutions)
% \ispartial   : partial/sample build
% \nocropmarks : no crop marks

% ---- cloze (fill-in-the-blank) --------------------------------------------
% \clozemode is set by the writer via \def: blank | key | full. `blank` hides
% the answer behind a rule measured from the real box, so the answer is never
% typeset and cannot be recovered from the PDF. Orthogonal to \issolution.
\providecommand{\clozemode}{blank}
\providecolor{parodyaccent}{HTML}{1F4E79} % themes that define it win
\newlength{\parodyclozewd}

\newcommand{\parody@clozeswitch}[3]{% #1 blank, #2 key, #3 full
  \ifdefstring{\clozemode}{full}{#3}{%
    \ifdefstring{\clozemode}{key}{#2}{#1}}}

\newcommand{\parody@blankrule}{%
  \ifdim\parodyclozewd<2em\relax\setlength{\parodyclozewd}{2em}\fi
  \leavevmode\rule[-0.55ex]{\dimexpr\parodyclozewd+1em\relax}{0.4pt}}

% \settowidth typesets in LR mode, so the outer math/text mode must be captured
% before measuring — \ifmmode inside the box would always be false.
\newcommand{\parody@cloze@text}[1]{%
  \parody@clozeswitch
    {\settowidth{\parodyclozewd}{#1}\parody@blankrule}
    {\underline{\textcolor{parodyaccent}{#1}}}
    {#1}}
\newcommand{\parody@cloze@math}[1]{%
  \parody@clozeswitch
    {\settowidth{\parodyclozewd}{$#1$}\mbox{\parody@blankrule}}
    {\underline{{\color{parodyaccent}#1}}}
    {#1}}
\newcommand{\cloze}[1]{%
  \relax\ifmmode\parody@cloze@math{#1}\else\parody@cloze@text{#1}\fi}

% Manual blank: nothing is hidden, so `key` keeps the rule and `full` drops it.
% Named \clozeblank, not \blank: memoir already defines \blank, and
% \newcommand over it errors and silently leaves memoir's version in force.
\newcommand{\clozeblank}[1]{%
  \parody@clozeswitch
    {\leavevmode\rule[-0.55ex]{#1}{0.4pt}}
    {\leavevmode\rule[-0.55ex]{#1}{0.4pt}}
    {}}

\newcounter{parodyclozeline}
\newcommand{\parody@rulelines}[1]{%
  \par\nobreak\medskip
  \setcounter{parodyclozeline}{0}%
  \@whilenum\value{parodyclozeline}<#1\do{%
    \noindent\rule{\linewidth}{0.4pt}\par\vspace{0.5\baselineskip}%
    \stepcounter{parodyclozeline}}%
  \medskip}
\newcommand{\clozelines}[1]{%
  \parody@clozeswitch{\parody@rulelines{#1}}{\parody@rulelines{#1}}{}}

% Hidden block: capture the content, then blank it to its own height.
\newsavebox{\parodyclozebox}
\newlength{\parodyclozeht}
% ONE framed box, not a stack of ruled lines. A stack reads as several separate
% answers, and on a typeset page it is indistinguishable from every other rule
% — table borders, heading rules, fraction bars. A box says "one thing goes
% here" and gives its own margins to write in.
%
% Built from primitives rather than \fbox or a tcolorbox, and both were tried:
% \framebox drew the top and bottom but no sides, and a tcolorbox blew LuaTeX's
% input stack inside an xsim exercise, where several clozes live — xsim writes
% exercise bodies out and re-reads them, and the box did not survive the trip.
% Two \hrules and an hbox between two \vrules cannot recurse.
%
% Floored so there is always somewhere to write: a one-line equation still
% needs room for a hand, which is taller than the type it replaces.
\newcommand{\parody@clozebox}[1]{% #1 = width
  \ifdim\parodyclozeht<2.6\baselineskip
    \setlength{\parodyclozeht}{2.6\baselineskip}%
  \fi
  \vbox{%
    \hrule height 0.4pt
    \hbox to #1{%
      \vrule width 0.4pt height \parodyclozeht depth 0pt
      \hfil
      \vrule width 0.4pt height \parodyclozeht depth 0pt}%
    \hrule height 0.4pt}}
\newcommand{\parody@clozeframe}{%
  \par\nobreak\medskip
  \noindent\parody@clozebox{\linewidth}%
  \par\medskip}

% A blanked equation KEEPS ITS NUMBER. Clozed equations are often the ones the
% prose refers to by number, and blanking the equation blanked its number with
% it, leaving [@eq:foo] pointing at nothing.
%
% The counter is stepped by hand and the number set beside the box, rather than
% making the box an equation body: the frame is a \vbox and cannot live in math
% mode.
% The counter is stepped and the label set HERE, not left to the hidden
% content. \label writes through a whatsit that only fires when its box is
% shipped out to the page, and the measuring box never is — so the content's
% own \label reaches the .aux never, and every reference to it stays undefined.
\newlength{\parodyclozenumwd}
\setlength{\parodyclozenumwd}{4em}
\newcommand{\parody@clozenumbered}[1]{%
  \par\nobreak\medskip
  \refstepcounter{equation}\label{#1}%
  \noindent\hbox to \linewidth{%
    \parody@clozebox{\dimexpr\linewidth-\parodyclozenumwd\relax}%
    \hfil
    \raisebox{0.42\parodyclozeht}{(\theequation)}}%
  \par\medskip}
% The mode is chosen at \begin, not at \end: content captured into an lrbox
% keeps whatever colour was in force at capture time, so a key-mode accent
% applied to \usebox would do nothing. Only `blank` needs the box (to measure
% the passage); key and full typeset in place. \clozemode cannot change inside
% the environment, so both halves always take the same branch.
\newenvironment{clozeequation}[1]
  {\def\parody@clozelabel{#1}%
   \parody@clozeswitch
     {\begin{lrbox}{\parodyclozebox}\begin{minipage}{\linewidth}}
     {\par\medskip\bgroup\color{parodyaccent}}
     {\par}}
  {\parody@clozeswitch
     {\end{minipage}\end{lrbox}%
      \setlength{\parodyclozeht}%
        {\dimexpr\ht\parodyclozebox+\dp\parodyclozebox\relax}%
      \parody@clozenumbered{\parody@clozelabel}}
     {\par\egroup\medskip}
     {\par}}

\newenvironment{clozeblock}
  {\parody@clozeswitch
     {\begin{lrbox}{\parodyclozebox}\begin{minipage}{\linewidth}}
     {\par\medskip\bgroup\color{parodyaccent}}
     {\par}}
  {\parody@clozeswitch
     {\end{minipage}\end{lrbox}%
      \setlength{\parodyclozeht}%
        {\dimexpr\ht\parodyclozebox+\dp\parodyclozebox\relax}%
      \parody@clozeframe}
     {\par\egroup\medskip}
     {\par}}

% ---- exercises (xsim) ----
\DeclareExerciseProperty{hash}
% End-of-chapter problem sets: named "Problem" (the web says the same, task
% #499) and numbered within the chapter, so print and web agree on "1.1".
\xsimsetup{exercise/within=chapter, exercise/name=Problem}
\ifdefined\issolution
  \xsimsetup{solution/print=true}
\else
  \xsimsetup{solution/print=false}
\fi
\DeclareExerciseType{labexercise}{
  exercise-env=labexercise,
  solution-env=labsolution,
  exercise-name=Lab Exercise,
  solution-name=Lab Solution,
  exercise-template=default,
  solution-template=default,
}
\ifdefined\issolution
  \xsimsetup{labsolution/print=true}
\fi

% Run-in heading: "Problem 1.1" set bold on the same line as the problem's
% first paragraph. xsim's `default` template sets a display heading instead.
% (RTC's profile gets this from the MIT class's run-in \subsubsection*;
% memoir's \subsubsection is a display head, so the run-in is spelled out.)
\DeclareExerciseEnvironmentTemplate{parodyrunin}{%
  \par\addvspace{\medskipamount}%
  \noindent
  {\bfseries\XSIMmixedcase{\GetExerciseName}\nobreakspace
   \GetExerciseProperty{counter}}%
  \hspace{0.75em}\ignorespaces
}{\par\addvspace{\medskipamount}}
\xsimsetup{exercise/template=parodyrunin, solution/template=parodyrunin}
% Lab problems: same run-in style, numbered L<chapter>.n as on the web.
\xsimsetup{
  labexercise/name = Problem,
  labexercise/within = chapter,
  labexercise/the-counter = L\thechapter.\arabic{labexercise},
  labexercise/template = parodyrunin,
  labsolution/template = parodyrunin,
}

% A cloze inside a solution always renders full — an answer key must not blank
% its own answers. Scoped to the environment, so the ambient \clozemode returns
% at \end. (\clozemode is \providecommand'd in the cloze block above.)
\AtBeginEnvironment{solution}{\renewcommand{\clozemode}{full}}
\AtBeginEnvironment{labsolution}{\renewcommand{\clozemode}{full}}


% ---- the house box: open frame, corner brackets, no fill ----------------
% An accent-coloured bold title over an open frame with bracket strokes at the
% corners — the same vocabulary parody-web uses for examples (task #318),
% rather than a tinted panel with a solid title bar. Each box type carries its
% own hue so a reader can tell a definition from a worked example at a glance,
% matching the web's per-type hue tokens (task #565).
\newlength{\parodybracketlen}\setlength{\parodybracketlen}{20pt}
\def\parody@brkoff{0.5pt}
\tikzset{parodybracketline/.style={line width=0.9pt, line cap=round}}
% #1 = hue. Four cases because a breakable box draws its own overlay per
% fragment: only the first fragment has a title, only the last has a foot.
% print.lua emits \tcblower to separate an example's statement from its
% solution. `empty` blanks the segmentation drawing along with the frame, and
% for a breakable box restoring `segmentation code` does not bring it back —
% so the rule is drawn in the overlay, on whichever fragment carries the
% segment (\tcbsegmentstate = 1). Without this the boundary vanishes silently.
\newcommand{\parody@brk@seg}[1]{%
  \ifnum\tcbsegmentstate=1
    \draw[#1,dashed,line width=0.5pt]
      ([xshift=\parody@brkoff]segmentation.west) --
      ([xshift=-\parody@brkoff]segmentation.east);
  \fi}
% Both verticals start just under the title, so the pair reads as one frame
% embracing the content with the title labelling it from above. (Hanging the
% right one from frame.north instead leaves the two starting at different
% heights — the frame top sits below the attached title.)
\newcommand{\parody@brk@un}[1]{%
  \draw[#1,parodybracketline]
    ([xshift=\parodybracketlen]title.south west) --
    ([xshift=\parody@brkoff]title.south west) --
    ([xshift=\parody@brkoff]frame.south west) --
    ([xshift=\parodybracketlen]frame.south west);
  \draw[#1,parodybracketline]
    ([xshift=-\parodybracketlen]frame.east |- title.south west) --
    ([xshift=-\parody@brkoff]frame.east |- title.south west) --
    ([xshift=-\parody@brkoff]frame.south east) --
    ([xshift=-\parodybracketlen]frame.south east);
  \parody@brk@seg{#1}}
\newcommand{\parody@brk@first}[1]{%
  \draw[#1,parodybracketline]
    ([xshift=\parodybracketlen]title.south west) --
    ([xshift=\parody@brkoff]title.south west) --
    ([xshift=\parody@brkoff]frame.south west);
  \draw[#1,parodybracketline]
    ([xshift=-\parodybracketlen]frame.east |- title.south west) --
    ([xshift=-\parody@brkoff]frame.east |- title.south west) --
    ([xshift=-\parody@brkoff]frame.south east);
  \parody@brk@seg{#1}}
\newcommand{\parody@brk@mid}[1]{%
  \draw[#1,parodybracketline]
    ([xshift=\parody@brkoff]frame.north west) --
    ([xshift=\parody@brkoff]frame.south west);
  \draw[#1,parodybracketline]
    ([xshift=-\parody@brkoff]frame.north east) --
    ([xshift=-\parody@brkoff]frame.south east);
  \parody@brk@seg{#1}}
\newcommand{\parody@brk@last}[1]{%
  \draw[#1,parodybracketline]
    ([xshift=\parody@brkoff]frame.north west) --
    ([xshift=\parody@brkoff]frame.south west) --
    ([xshift=\parodybracketlen]frame.south west);
  \draw[#1,parodybracketline]
    ([xshift=-\parody@brkoff]frame.north east) --
    ([xshift=-\parody@brkoff]frame.south east) --
    ([xshift=-\parodybracketlen]frame.south east);
  \parody@brk@seg{#1}}
\tcbset{
  parodyboxbase/.style={
    enhanced, breakable, empty,
    attach boxed title to top left,
    minipage boxed title,
    boxed title style={empty, size=minimal, toprule=0pt, top=3pt,
      left=0pt, bottom=2pt, overlay={}},
    fonttitle=\bfseries,
    parbox=false,
    before upper={\setlength{\parindent}{0pt}\noindent},
    boxsep=0pt, left=5pt, right=5pt, top=5pt, bottom=3pt,
    pad at break=0mm,
    before skip=8pt, after skip=8pt,
  },
  parodybox/.style n args={1}{
    parodyboxbase,
    coltitle=#1,
    overlay unbroken={\parody@brk@un{#1}},
    overlay first={\parody@brk@first{#1}},
    overlay middle={\parody@brk@mid{#1}},
    overlay last={\parody@brk@last{#1}},
  },
}

% ---- theorem-like environments: \begin{<env>}{title}{label} ----
\newcounter{thmctr}
\newtcolorbox{parodythmbox}[2]{parodybox=parodyaccent,
  title={#1\if\relax\detokenize{#2}\relax\else\ \textnormal{\itshape #2}\fi}}
\newenvironment{definition}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Definition~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{theorem}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Theorem~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{lemma}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Lemma~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{corollary}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Corollary~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{proposition}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Proposition~\thethmctr}{#1}}
  {\end{parodythmbox}}
\crefname{thmctr}{result}{results}

% ---- infobox: \begin{infobox}[label=...]{title} ----
\newcounter{infoboxctr}
\newenvironment{infobox}[2][]
  {\refstepcounter{infoboxctr}%
   \begin{tcolorbox}[parodybox=parodyinfoframe,
     title={Box~\theinfoboxctr%
       \if\relax\detokenize{#2}\relax\else\ \textnormal{\itshape #2}\fi}, #1]}
  {\end{tcolorbox}}
\crefname{infoboxctr}{box}{boxes}

% ---- examples: \begin{myexample}[version]{id}{hash} ----
\newcounter{examplectr}
\newenvironment{myexample}[3][]
  {\refstepcounter{examplectr}%
   \begin{tcolorbox}[parodybox=parodyexframe,
     title={Example~\theexamplectr}]%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi%
   \ifstrequal{#2}{#3}{}{\if\relax\detokenize{#3}\relax\else\label{#3}\fi}}
  {\end{tcolorbox}}
\crefname{examplectr}{example}{examples}

% ---- listings: \begin{listingsbox(float)}{minted-style}{caption}{id}({pos})
% The style name encodes the language (clisting*, pythonlisting,
% armlisting, textlisting). minted scans for the *outermost* environment's
% \end, which \VerbatimEnvironment arranges when called in begin-code.
\newcounter{listingctr}
\newenvironment{mintedwrapper}{\par\medskip}{\par\medskip}
\makeatletter
\newcommand{\parody@listinghead}[2]{%
  \par\medskip\refstepcounter{listingctr}%
  \noindent\textbf{Listing~\thelistingctr}%
  \if\relax\detokenize{#1}\relax\else: #1\fi
  \if\relax\detokenize{#2}\relax\else\label{#2}\fi\par\nopagebreak}
\newcommand{\parody@stylelang}[1]{%
  \def\parody@lang{text}%
  \in@{clisting}{#1}\ifin@\def\parody@lang{c}\fi
  \in@{pythonlisting}{#1}\ifin@\def\parody@lang{python}\fi
  \in@{armlisting}{#1}\ifin@\def\parody@lang{nasm}\fi}
\newenvironment{listingsbox}[3]
  {\parody@listinghead{#2}{#3}%
   \parody@stylelang{#1}%
   \VerbatimEnvironment
   \begin{minted}[autogobble,fontsize=\small,frame=leftline]{\parody@lang}}
  {\end{minted}\par\medskip}
\newenvironment{listingsboxfloat}[4]
  {\parody@listinghead{#2}{#3}%
   \parody@stylelang{#1}%
   \VerbatimEnvironment
   \begin{minted}[autogobble,fontsize=\small,frame=leftline]{\parody@lang}}
  {\end{minted}\par\medskip}
\makeatother
\crefname{listingctr}{listing}{listings}

% ---- algorithms ----
\newcounter{algorithmctr}
\newenvironment{algorithmcenter}{\par\medskip\begin{center}}{\end{center}\par\medskip}
\newenvironment{algorithm}[1][H]{\par}{\par}
\newcommand{\algcaption}[2]{%
  \refstepcounter{algorithmctr}%
  \noindent\textbf{Algorithm~\thealgorithmctr}%
  \if\relax\detokenize{#2}\relax\else: #2\fi
  \if\relax\detokenize{#1}\relax\else\label{#1}\fi\par}
\crefname{algorithmctr}{algorithm}{algorithms}

% ---- captions for figures/tables: \figcaption[opts][]{label}{caption} ----
% \figcaption[short][float|nofloat]{id}{caption}: nofloat (de-floated
% assets) wraps \captionof in a minipage, legal outside floats
\NewDocumentCommand{\figcaption}{O{}O{float}mm}{%
  \ifstrequal{#2}{nofloat}{%
    \noindent\begin{minipage}{\linewidth}\captionof{figure}{#4}%
    \if\relax\detokenize{#3}\relax\else\label{#3}\fi\end{minipage}\par}{%
    \caption{#4}\if\relax\detokenize{#3}\relax\else\label{#3}\fi}}
% \tabcaption[short][float|nofloat]{id}{caption} (ancestor semantics):
% nofloat wraps \captionof in a minipage (legal outside floats)
\NewDocumentCommand{\tabcaption}{O{}O{float}mm}{%
  \ifstrequal{#2}{nofloat}{%
    \noindent\begin{minipage}{\linewidth}\captionof{table}{#4}%
    \if\relax\detokenize{#3}\relax\else\label{#3}\fi\end{minipage}\par}{%
    \if\relax\detokenize{#1}\relax\caption{#4}\else\caption[#1]{#4}\fi
    \if\relax\detokenize{#3}\relax\else\label{#3}\fi}}
