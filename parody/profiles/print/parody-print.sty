% parody generic print profile.
% Implements the environments and commands emitted by parody/filters/print.lua
% with stock LaTeX packages — the portable counterpart of rtc-book's
% common/styles-tex (whose MIT Press class and licensed fonts are
% book-private and belong in a private profile package, not here).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{parody-print}[2026/06/10 parody generic print profile]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{bm}
\RequirePackage{cancel}
\RequirePackage{pgf} % matplotlib-exported figures via \inputpgf
% matplotlib's pgf backend wraps math in \mathdefault; identity is the
% upstream-recommended definition outside matplotlib's own preamble.
\providecommand{\mathdefault}[1]{#1}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{longtable} % pandoc emits it for pipe tables
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{minted}
\RequirePackage{xsim}
\RequirePackage{menukeys}
\RequirePackage{xurl}
\RequirePackage{fontawesome5}
\RequirePackage{imakeidx}
\RequirePackage{hyperref}
% Links carry no visible border. hyperref's default draws a box around every
% cross-reference, and this PDF is something students PRINT — a section at a
% time, or the whole book — so 259 boxes would be 259 boxes on paper. Set via
% \hypersetup rather than the `hidelinks` package option: a book preamble that
% loads hyperref itself would make the option an unrecoverable clash, and
% pdfborder is the form every hyperref version accepts.
\hypersetup{pdfborder={0 0 0}}
% No `capitalise`: cross-ref labels follow the case of the reference key, so
% [@fig:foo] -> \cref -> "figure 1" and [@Fig:foo] -> \Cref -> "Figure 1"
% (task #296). `capitalise` would force \cref to capitalize too, defeating
% the lowercase intent that print.lua's crossref/hashref handlers encode.
\RequirePackage[noabbrev,nameinlink]{cleveref}

\makeindex

% ---- conditional build flags (set by the writer via \def before \input) ----
% \issolution  : solutions manual build (print solutions)
% \ispartial   : partial/sample build
% \nocropmarks : no crop marks

% ---- cloze (fill-in-the-blank) --------------------------------------------
% \clozemode is set by the writer via \def: blank | key | full. `blank` hides
% the answer behind a rule measured from the real box, so the answer is never
% typeset and cannot be recovered from the PDF. Orthogonal to \issolution.
\providecommand{\clozemode}{blank}
\providecolor{parodyaccent}{HTML}{1F4E79} % themes that define it win
\newlength{\parodyclozewd}

\newcommand{\parody@clozeswitch}[3]{% #1 blank, #2 key, #3 full
  \ifdefstring{\clozemode}{full}{#3}{%
    \ifdefstring{\clozemode}{key}{#2}{#1}}}

\newcommand{\parody@blankrule}{%
  \ifdim\parodyclozewd<2em\relax\setlength{\parodyclozewd}{2em}\fi
  \leavevmode\rule[-0.55ex]{\dimexpr\parodyclozewd+1em\relax}{0.4pt}}

% \settowidth typesets in LR mode, so the outer math/text mode must be captured
% before measuring — \ifmmode inside the box would always be false.
\newcommand{\parody@cloze@text}[1]{%
  \parody@clozeswitch
    {\settowidth{\parodyclozewd}{#1}\parody@blankrule}
    {\underline{\textcolor{parodyaccent}{#1}}}
    {#1}}
\newcommand{\parody@cloze@math}[1]{%
  \parody@clozeswitch
    {\settowidth{\parodyclozewd}{$#1$}\mbox{\parody@blankrule}}
    {\underline{{\color{parodyaccent}#1}}}
    {#1}}
\newcommand{\cloze}[1]{%
  \relax\ifmmode\parody@cloze@math{#1}\else\parody@cloze@text{#1}\fi}

% Manual blank: nothing is hidden, so `key` keeps the rule and `full` drops it.
% Named \clozeblank, not \blank: memoir already defines \blank, and
% \newcommand over it errors and silently leaves memoir's version in force.
\newcommand{\clozeblank}[1]{%
  \parody@clozeswitch
    {\leavevmode\rule[-0.55ex]{#1}{0.4pt}}
    {\leavevmode\rule[-0.55ex]{#1}{0.4pt}}
    {}}

\newcounter{parodyclozeline}
\newcommand{\parody@rulelines}[1]{%
  \par\nobreak\medskip
  \setcounter{parodyclozeline}{0}%
  \@whilenum\value{parodyclozeline}<#1\do{%
    \noindent\rule{\linewidth}{0.4pt}\par\vspace{0.5\baselineskip}%
    \stepcounter{parodyclozeline}}%
  \medskip}
\newcommand{\clozelines}[1]{%
  \parody@clozeswitch{\parody@rulelines{#1}}{\parody@rulelines{#1}}{}}

% Hidden block: capture the content, then blank it to its own height.
\newsavebox{\parodyclozebox}
% The mode is chosen at \begin, not at \end: content captured into an lrbox
% keeps whatever colour was in force at capture time, so a key-mode accent
% applied to \usebox would do nothing. Only `blank` needs the box (to measure
% the passage); key and full typeset in place. \clozemode cannot change inside
% the environment, so both halves always take the same branch.
\newenvironment{clozeblock}
  {\parody@clozeswitch
     {\begin{lrbox}{\parodyclozebox}\begin{minipage}{\linewidth}}
     {\par\medskip\bgroup\color{parodyaccent}}
     {\par}}
  {\parody@clozeswitch
     {\end{minipage}\end{lrbox}%
      \@tempcnta=\dimexpr\ht\parodyclozebox+\dp\parodyclozebox\relax
      \@tempcntb=\baselineskip
      \divide\@tempcnta by \@tempcntb
      \advance\@tempcnta by 1
      \parody@rulelines{\@tempcnta}}
     {\par\egroup\medskip}
     {\par}}

% ---- exercises (xsim) ----
\DeclareExerciseProperty{hash}
\ifdefined\issolution
  \xsimsetup{solution/print=true}
\else
  \xsimsetup{solution/print=false}
\fi
\DeclareExerciseType{labexercise}{
  exercise-env=labexercise,
  solution-env=labsolution,
  exercise-name=Lab Exercise,
  solution-name=Lab Solution,
  exercise-template=default,
  solution-template=default,
}
\ifdefined\issolution
  \xsimsetup{labsolution/print=true}
\fi

% A cloze inside a solution always renders full — an answer key must not blank
% its own answers. Scoped to the environment, so the ambient \clozemode returns
% at \end. (\clozemode is \providecommand'd in the cloze block above.)
\AtBeginEnvironment{solution}{\renewcommand{\clozemode}{full}}
\AtBeginEnvironment{labsolution}{\renewcommand{\clozemode}{full}}


% ---- theorem-like environments: \begin{<env>}{title}{label} ----
\newcounter{thmctr}
\newtcolorbox{parodythmbox}[2]{%
  enhanced, breakable, colback=black!3, colframe=black!40,
  title={\textbf{#1}\if\relax\detokenize{#2}\relax\else\quad\textit{#2}\fi},
}
\newenvironment{definition}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Definition~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{theorem}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Theorem~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{lemma}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Lemma~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{corollary}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Corollary~\thethmctr}{#1}}
  {\end{parodythmbox}}
\newenvironment{proposition}[2]
  {\refstepcounter{thmctr}%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi
   \begin{parodythmbox}{Proposition~\thethmctr}{#1}}
  {\end{parodythmbox}}
\crefname{thmctr}{result}{results}

% ---- infobox: \begin{infobox}[label=...]{title} ----
\newcounter{infoboxctr}
\newenvironment{infobox}[2][]
  {\refstepcounter{infoboxctr}%
   \begin{tcolorbox}[enhanced, breakable, colback=blue!4,
     colframe=blue!35!black!50,
     title={\textbf{Box~\theinfoboxctr}%
       \if\relax\detokenize{#2}\relax\else: #2\fi}, #1]}
  {\end{tcolorbox}}
\crefname{infoboxctr}{box}{boxes}

% ---- examples: \begin{myexample}[version]{id}{hash} ----
\newcounter{examplectr}
\newenvironment{myexample}[3][]
  {\refstepcounter{examplectr}%
   \begin{tcolorbox}[enhanced, breakable, colback=green!4,
     colframe=green!35!black!50,
     title={\textbf{Example~\theexamplectr}}]%
   \if\relax\detokenize{#2}\relax\else\label{#2}\fi%
   \ifstrequal{#2}{#3}{}{\if\relax\detokenize{#3}\relax\else\label{#3}\fi}}
  {\end{tcolorbox}}
\crefname{examplectr}{example}{examples}

% ---- listings: \begin{listingsbox(float)}{minted-style}{caption}{id}({pos})
% The style name encodes the language (clisting*, pythonlisting,
% armlisting, textlisting). minted scans for the *outermost* environment's
% \end, which \VerbatimEnvironment arranges when called in begin-code.
\newcounter{listingctr}
\newenvironment{mintedwrapper}{\par\medskip}{\par\medskip}
\makeatletter
\newcommand{\parody@listinghead}[2]{%
  \par\medskip\refstepcounter{listingctr}%
  \noindent\textbf{Listing~\thelistingctr}%
  \if\relax\detokenize{#1}\relax\else: #1\fi
  \if\relax\detokenize{#2}\relax\else\label{#2}\fi\par\nopagebreak}
\newcommand{\parody@stylelang}[1]{%
  \def\parody@lang{text}%
  \in@{clisting}{#1}\ifin@\def\parody@lang{c}\fi
  \in@{pythonlisting}{#1}\ifin@\def\parody@lang{python}\fi
  \in@{armlisting}{#1}\ifin@\def\parody@lang{nasm}\fi}
\newenvironment{listingsbox}[3]
  {\parody@listinghead{#2}{#3}%
   \parody@stylelang{#1}%
   \VerbatimEnvironment
   \begin{minted}[autogobble,fontsize=\small,frame=leftline]{\parody@lang}}
  {\end{minted}\par\medskip}
\newenvironment{listingsboxfloat}[4]
  {\parody@listinghead{#2}{#3}%
   \parody@stylelang{#1}%
   \VerbatimEnvironment
   \begin{minted}[autogobble,fontsize=\small,frame=leftline]{\parody@lang}}
  {\end{minted}\par\medskip}
\makeatother
\crefname{listingctr}{listing}{listings}

% ---- algorithms ----
\newcounter{algorithmctr}
\newenvironment{algorithmcenter}{\par\medskip\begin{center}}{\end{center}\par\medskip}
\newenvironment{algorithm}[1][H]{\par}{\par}
\newcommand{\algcaption}[2]{%
  \refstepcounter{algorithmctr}%
  \noindent\textbf{Algorithm~\thealgorithmctr}%
  \if\relax\detokenize{#2}\relax\else: #2\fi
  \if\relax\detokenize{#1}\relax\else\label{#1}\fi\par}
\crefname{algorithmctr}{algorithm}{algorithms}

% ---- captions for figures/tables: \figcaption[opts][]{label}{caption} ----
% \figcaption[short][float|nofloat]{id}{caption}: nofloat (de-floated
% assets) wraps \captionof in a minipage, legal outside floats
\NewDocumentCommand{\figcaption}{O{}O{float}mm}{%
  \ifstrequal{#2}{nofloat}{%
    \noindent\begin{minipage}{\linewidth}\captionof{figure}{#4}%
    \if\relax\detokenize{#3}\relax\else\label{#3}\fi\end{minipage}\par}{%
    \caption{#4}\if\relax\detokenize{#3}\relax\else\label{#3}\fi}}
% \tabcaption[short][float|nofloat]{id}{caption} (ancestor semantics):
% nofloat wraps \captionof in a minipage (legal outside floats)
\NewDocumentCommand{\tabcaption}{O{}O{float}mm}{%
  \ifstrequal{#2}{nofloat}{%
    \noindent\begin{minipage}{\linewidth}\captionof{table}{#4}%
    \if\relax\detokenize{#3}\relax\else\label{#3}\fi\end{minipage}\par}{%
    \if\relax\detokenize{#1}\relax\caption{#4}\else\caption[#1]{#4}\fi
    \if\relax\detokenize{#3}\relax\else\label{#3}\fi}}
\gdef\graphicslist{}
\newcommand{\inputpgf}[1]{\input{#1.pgf}}
\providecommand{\includestandalone}[2][]{\includegraphics[#1]{#2}}

