%% parody-twin — the translated twin of each English print page (task #825).
%%
%% \begin{twinpage}{<page>}{<start scale>}{<restore>}{<chapter mark>}{<section mark>}[<chapter title>]
%%   … the page's translated content …
%% \end{twinpage}
%%
%% Sets the English page number, restores the counters the English had at the
%% page's first sentence (so equations, figures and boxes number alike), sets
%% the running heads, and typesets the content at the class's own size in a
%% column 1/s as wide as the text block, then scales it by s: the largest s
%% on the grid <start>, <start> - 0.01, ... at which the page fits, with no
%% floor beyond 0.05: nothing is ever dropped to fit. It finds that s in a few
%% attempts, not one per step (\__parodytwin_search:nn).
%% Writes "TWINFIT page=<n> scale=<s>" to the log; parody reads it back,
%% and "TWINTRIES page=<n> tries=<attempts>".
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{parody-twin}[2026/10/17 parody twin pages]
\RequirePackage{graphicx}
\RequirePackage{xparse}

% A translated heading is not title-cased: titlecaps would capitalise every
% German noun-and-verb alike and mangle CJK.
\AtBeginDocument{\renewcommand{\parodytitlecap}[1]{#1}}

% \parodytwinset{counter}{value}: the restore list names every counter the
% English had; one this document lacks is skipped, not an error.
\newcommand{\parodytwinset}[2]{\ifcsname c@#1\endcsname\setcounter{#1}{#2}\fi}

% \parodytwinlabel{label}: the current label the English had there, so a
% \label before the page's first numbered thing records what the English
% recorded. Without it a label under an unnumbered heading right after a
% chapter heading came out empty: \chapter sets the label inside the page's
% group (System Dynamics' lead-in, 11 labels).
\newcommand{\parodytwinlabel}[1]{\def\@currentlabel{#1}}

\newcommand{\parodytwinuntranslatedtext}{English: not yet translated}
\newcommand{\parodytwinstaletext}{may lag the English}
\newcommand{\parodyuntranslated}{{\footnotesize\itshape[\parodytwinuntranslatedtext]}\ }
\newcommand{\parodystale}{{\footnotesize\itshape[\parodytwinstaletext]}\ }

% \def\parodytwinchapterlabels{\label{<slug>}\label{<hash>}} before a twinpage
% that opens a chapter: set right after its \chapter, so references resolve.
\providecommand{\parodytwinchapterlabels}{}

\ExplSyntaxOn
\box_new:N \g__parodytwin_box
\dim_new:N \l__parodytwin_width
\dim_new:N \l__parodytwin_avail
\fp_new:N \l__parodytwin_scale
\tl_new:N \l__parodytwin_restore
\dim_new:N \l__parodytwin_parindent
\skip_new:N \l__parodytwin_parskip
\fp_new:N \l__parodytwin_start_fp
\fp_new:N \l__parodytwin_used_fp
\int_new:N \l__parodytwin_step_int
\int_new:N \l__parodytwin_last_int
\int_new:N \l__parodytwin_lo_int
\int_new:N \l__parodytwin_hi_int
\int_new:N \l__parodytwin_gap_int
\int_new:N \l__parodytwin_probe_int
\int_new:N \l__parodytwin_found_int
\int_new:N \l__parodytwin_tries_int
\bool_new:N \l__parodytwin_fits_bool

\cs_new_protected:Npn \__parodytwin_minipage:n #1
  {
    \begin{minipage}[t]{\l__parodytwin_width}
      % minipage zeroes these; the twin's paragraphs look like the book's
      \dim_set_eq:NN \parindent \l__parodytwin_parindent
      \skip_set_eq:NN \parskip \l__parodytwin_parskip
      \cs_set:Npn \thempfootnote { \arabic{mpfootnote} }
      \setcounter{mpfootnote}{\value{footnote}}
      #1
    \end{minipage}
  }

% Every counter, saved before measuring and put back after each attempt, so
% a counter the restore list does not name cannot drift by one per attempt.
% xsim numbers its exercises with an expl3 int, not a LaTeX counter: put it
% back too, or every attempt registers every exercise on the page anew and
% main.xsim grows a line TeX cannot read back. But the page AS SET must not
% reuse the attempts' ids: xsim then takes each exercise for one already used
% and never steps its counter, so every exercise label comes out empty. The
% attempts share one set of ids; the page as set gets the next.
\int_new:N \g__parodytwin_xsim_id_int
\int_new:N \g__parodytwin_xsim_after_int
\cs_new_protected:Npn \__parodytwin_save_counters:
  {
    \cs_set:Npn \@elt ##1
      { \cs_gset:cpx { parodytwin@save@##1 } { \int_use:c { c@##1 } } }
    \cl@@ckpt
    \cs_if_exist:NT \g_xsim_id_int
      { \int_gset_eq:NN \g__parodytwin_xsim_id_int \g_xsim_id_int }
  }
\cs_new_protected:Npn \__parodytwin_put_counters:
  {
    \cs_set:Npn \@elt ##1
      { \int_gset:cn { c@##1 } { \use:c { parodytwin@save@##1 } } }
    \cl@@ckpt
    \cs_if_exist:NT \g_xsim_id_int
      { \int_gset_eq:NN \g_xsim_id_int \g__parodytwin_xsim_id_int }
  }

% One attempt: set the page's content at grid step #1 below the start scale
% (scale = start - #1 * 0.01) in the measuring box, put the counters back,
% and record whether it fits. Counts the attempts for the log.
\cs_new_protected:Npn \__parodytwin_try:nn #1 #2
  {
    \int_set:Nn \l__parodytwin_step_int { #1 }
    \fp_set:Nn \l__parodytwin_scale
      { \l__parodytwin_start_fp - \l__parodytwin_step_int * 0.01 }
    \int_incr:N \l__parodytwin_tries_int
    \dim_set:Nn \l__parodytwin_width { \fp_to_dim:n { \textwidth / \l__parodytwin_scale } }
    \group_begin:
      % measuring: no labels, no index entries, no TOC lines
      \RenewDocumentCommand \label { o m } { }
      \cs_set_eq:NN \index \use_none:n
      \cs_set_eq:NN \addcontentsline \use_none:nnn
      \l__parodytwin_restore
      \hbox_gset:Nn \g__parodytwin_box { \__parodytwin_minipage:n { #2 } }
    \group_end:
    \cs_if_exist:NT \g_xsim_id_int
      { \int_gset_eq:NN \g__parodytwin_xsim_after_int \g_xsim_id_int }
    \__parodytwin_put_counters:
    \fp_set:Nn \l__parodytwin_used_fp
      { ( \dim_to_fp:n { \box_ht:N \g__parodytwin_box + \box_dp:N \g__parodytwin_box } )
        * \l__parodytwin_scale }
    \fp_compare:nNnTF { \l__parodytwin_used_fp } > { \dim_to_fp:n { \l__parodytwin_avail } }
      { \bool_set_false:N \l__parodytwin_fits_bool }
      { \bool_set_true:N \l__parodytwin_fits_bool }
  }

% The largest scale on the grid start, start - 0.01, ... at which the page
% fits, down to the first step at or below 0.05 (set there even if it does
% not fit: nothing is ever dropped). That is what stepping down 0.01 at a time
% finds, whenever fitting is monotone in the scale, but in a few attempts
% rather than one per step. After the start, it tries a guess (the content's
% area is about constant, so its scaled height goes as the square of the
% scale); then, between a step known not to fit (lo) and one known to (hi),
% it gallops down from a guess that did not fit, and bisects.
\cs_new_protected:Npn \__parodytwin_search:nn #1 #2
  {
    \fp_set:Nn \l__parodytwin_start_fp { #1 }
    \int_set:Nn \l__parodytwin_last_int
      { \fp_eval:n { max ( 0 , ceil ( ( \l__parodytwin_start_fp - 0.05 ) * 100 ) ) } }
    \int_zero:N \l__parodytwin_found_int
    \__parodytwin_try:nn { 0 } { #2 }
    \bool_if:NF \l__parodytwin_fits_bool
      {
        \int_compare:nNnT { \l__parodytwin_last_int } > { 0 }
          { \__parodytwin_bracket:n { #2 } }
      }
    \fp_set:Nn \l__parodytwin_scale
      { \l__parodytwin_start_fp - \l__parodytwin_found_int * 0.01 }
    % and its column: the last attempt may have been a step that did not fit,
    % whose width would otherwise set the page
    \dim_set:Nn \l__parodytwin_width { \fp_to_dim:n { \textwidth / \l__parodytwin_scale } }
  }

% Step 0 did not fit and there is room below it: find the first step that
% fits, into \l__parodytwin_found_int (the last step if none does).
\cs_new_protected:Npn \__parodytwin_bracket:n #1
  {
    \int_zero:N \l__parodytwin_lo_int
    \int_set:Nn \l__parodytwin_hi_int { -1 }
    \fp_compare:nNnTF { \dim_to_fp:n { \l__parodytwin_avail } } > { 0 }
      {
        \int_set:Nn \l__parodytwin_probe_int
          {
            \fp_eval:n
              {
                max ( 1 , min ( \l__parodytwin_last_int ,
                  floor ( ( \l__parodytwin_start_fp
                    - \l__parodytwin_start_fp
                      * sqrt ( \dim_to_fp:n { \l__parodytwin_avail }
                               / \l__parodytwin_used_fp ) ) * 100 ) ) )
              }
          }
      }
      { \int_set_eq:NN \l__parodytwin_probe_int \l__parodytwin_last_int }
    \__parodytwin_probe:n { #1 }
    % gallop down (1, 2, 4, ... steps) until a step fits, or the last step
    \int_set:Nn \l__parodytwin_gap_int { 1 }
    \int_while_do:nNnn { \l__parodytwin_hi_int } < { 0 }
      {
        \int_set:Nn \l__parodytwin_probe_int
          { \int_min:nn { \l__parodytwin_lo_int + \l__parodytwin_gap_int } { \l__parodytwin_last_int } }
        \__parodytwin_probe:n { #1 }
        \int_compare:nNnT { \l__parodytwin_lo_int } = { \l__parodytwin_last_int }
          { \int_set_eq:NN \l__parodytwin_hi_int \l__parodytwin_last_int }
        \int_set:Nn \l__parodytwin_gap_int { 2 * \l__parodytwin_gap_int }
      }
    % bisect between them
    \int_while_do:nNnn { \l__parodytwin_hi_int - \l__parodytwin_lo_int } > { 1 }
      {
        \int_set:Nn \l__parodytwin_probe_int
          { \int_div_truncate:nn { \l__parodytwin_lo_int + \l__parodytwin_hi_int } { 2 } }
        \__parodytwin_probe:n { #1 }
      }
    \int_set_eq:NN \l__parodytwin_found_int \l__parodytwin_hi_int
  }

% Try the step in \l__parodytwin_probe_int; it becomes hi if it fits, lo if not.
\cs_new_protected:Npn \__parodytwin_probe:n #1
  {
    \__parodytwin_try:nn { \l__parodytwin_probe_int } { #1 }
    \bool_if:NTF \l__parodytwin_fits_bool
      { \int_set_eq:NN \l__parodytwin_hi_int \l__parodytwin_probe_int }
      { \int_set_eq:NN \l__parodytwin_lo_int \l__parodytwin_probe_int }
  }

\cs_new_protected:Npn \__parodytwin_fit:nn #1 #2
  {
    \__parodytwin_save_counters:
    \int_zero:N \l__parodytwin_tries_int
    \__parodytwin_search:nn { #1 } { #2 }
    \iow_log:x { TWINFIT ~ page=\thepage \c_space_tl scale=\fp_use:N \l__parodytwin_scale }
    \iow_log:x { TWINTRIES ~ page=\thepage \c_space_tl tries=\int_use:N \l__parodytwin_tries_int }
    \cs_if_exist:NT \g_xsim_id_int
      { \int_gset_eq:NN \g_xsim_id_int \g__parodytwin_xsim_after_int }
    \l__parodytwin_restore
    % Straight onto the page, no paragraph and no interline glue, and as a
    % box whose whole extent is HEIGHT (depth 0): a [t] minipage's height is
    % only its first line, and \topskip would pad that, unmeasured, by up to
    % 10pt and push a tightly fitted page onto a second sheet.
    \nointerlineskip
    \vbox:n
      {
        \hbox:n { \scalebox { \fp_use:N \l__parodytwin_scale } { \__parodytwin_minipage:n { #2 } } }
        \kern 0pt
      }
  }

\NewDocumentEnvironment { twinpage } { m m m m m o +b }
  {
    \clearpage
    \dim_set_eq:NN \l__parodytwin_parindent \parindent
    \skip_set_eq:NN \l__parodytwin_parskip \parskip
    \setcounter{page}{#1}
    \tl_set:Nn \l__parodytwin_restore { #3 }
    \IfValueTF { #6 }
      {
        % the chapter opens on this page: its heading, then the content below
        \group_begin:
          \cs_set_eq:NN \clearforchapter \relax
          #3
          \addtocounter{chapter}{-1}
          \chapter{#6}
          % the chapter's own labels, as the English sets them after \chapter
          \parodytwinchapterlabels
        \group_end:
        \cs_gset_eq:NN \parodytwinchapterlabels \prg_do_nothing:
      }
      { #4 #5 }
    % run the page builder, so \pagetotal counts a chapter heading just set
    \par \tex_penalty:D 10000 \scan_stop:
    \dim_set:Nn \l__parodytwin_avail { \textheight - \pagetotal - 1pt }
    \__parodytwin_fit:nn { #2 } { #7 }
  }
  { \clearpage }
\ExplSyntaxOff
