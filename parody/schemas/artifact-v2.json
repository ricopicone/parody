{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ricopicone/parody/schemas/artifact-v2.json",
  "title": "Parody artifact schema v2",
  "description": "v1 plus rtc-style stable short-hash IDs: optional \"hash\" on sections and anchors (meta's h= header/div attributes and front-matter hash keys). Hashes are permalink/cross-ref/QR keys and must be unique per book; the build errors on duplicates. Superset of homepage-django's notebooks_data/*.json. The html fields are Django-template-flavored ({% media %}, {% static %}, {% cite %} tags) for parity; consumers either re-render through Django's template engine or resolve the tags themselves. Provenance keys are optional because pre-parody artifacts lack them.",
  "type": "object",
  "required": [
    "title",
    "author",
    "chapters"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "generator": {
      "type": "string"
    },
    "source_repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "built_at": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "author": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "acronym": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "pdf_file": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "slug",
          "sections"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "slug",
                "html",
                "anchors"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "slug": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "html": {
                  "type": "string"
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "level": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "is_section": {
                        "type": "boolean"
                      },
                      "hash": {
                        "type": "string"
                      }
                    }
                  }
                },
                "has_solutions": {
                  "type": "boolean"
                },
                "solutions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "content"
                    ],
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "problems": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "content"
                    ],
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "hash": {
                  "type": "string"
                },
                "online_only": {
                  "description": "Section is licensed for the public web subset (e.g. rtcbook.org) but not the print book — meta's `.online-only` sections. Drives `parody build --online-only`.",
                  "type": "boolean"
                },
                "online_resources": {
                  "description": "Per-section web-only addenda (rendered HTML) authored in a sibling <slug>.online.md — meta's online-resources-editable content.",
                  "type": "string"
                }
              }
            }
          },
          "hash": {
            "type": "string"
          },
          "appendix": {
            "type": "boolean"
          }
        }
      }
    },
    "book": {
      "description": "Bibliographic / editions metadata (meta's book-defs.json), emitted by the book plugin from the parody.yaml `book:` block. Carries the full title, short name, companion URL, and a list of editions (number, year, publisher, ISBN, publisher URL, series, and version-track bindings).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "companion_url": {
          "type": "string"
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "edition": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "year": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "isbn": {
                "type": "string"
              },
              "series": {
                "type": "string"
              },
              "series_name": {
                "type": "string"
              },
              "url_companion": {
                "type": "string"
              },
              "url_publisher": {
                "type": "string"
              },
              "v_ts": {
                "type": "string"
              },
              "v_ds": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "videos": {
      "description": "Lecture-video playlist links (meta's book-json/videos.json), emitted by the videos plugin. Per edition: a playlist id and the sections that have a video, each mapping a section hash to one or more 1-based positions in the playlist. Only sections present in this build (in-book or apocrypha) are emitted.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edition",
          "playlist",
          "sections"
        ],
        "properties": {
          "edition": {
            "type": "string"
          },
          "playlist": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hash",
                "indices"
              ],
              "properties": {
                "hash": {
                  "type": "string"
                },
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "apocrypha": {
      "description": "Online-only sections — present on the website but not in this build (meta's book-json/apocrypha.json). The apocrypha plugin emits the subset whose hash is not an in-book section/anchor, so consumers can build a complete table of contents spanning in-book and online-only content.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hash",
          "id",
          "title",
          "type"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "v_specific": {
            "type": "boolean"
          },
          "v_ts": {
            "type": [
              "string",
              "null"
            ]
          },
          "v_ds": {
            "type": [
              "string",
              "null"
            ]
          },
          "subhash": {
            "type": "string"
          }
        }
      }
    }
  }
}
